# Normalize only newly maintained repository text.
* text=auto
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.sh text eol=lf
*.ps1 text eol=crlf
*.csv text eol=lf

# Existing delivery manifests hash bytes. Do not normalize imported snapshots.
projects/g02/** -text
renovierung/k01_unterlagen/** -text
historie/diagnosen/** -text

# Binary / large geometry: ordinary Git in this initial repository, no LFS dependency.
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.tif binary
*.npz binary
*.mp4 binary
*.step -text -diff
*.stp -text -diff
*.prt binary

# Versioned native NX delivery; source/import snapshots remain unchanged.
cad/nx/**/*.prt filter=lfs diff=lfs merge=lfs -text

# Preserve generated evidence bytes: K02 fingerprints the actual G02 JSON files.
cad/nx/*.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
cad/nx/**/*.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# Retain the measured location evidence exactly as hashed by M01.2.
renovierung/planung/2026-11-04/M01_LAGERSTANDORTE_XY.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
renovierung/anbau/RANDSTREIFEN_REVIEW.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
renovierung/anbau/KATALOG.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
