# Local/native results: keep working NX files outside versioned sources.
/local_data/*
!/local_data/README.md
/reports/local/
**/ausgabe/
**/fehlerberichte/
**/_step_quellen/
**/LETZTER_ERFOLGREICHER_LAUF.json
**/LETZTES_HAUS_*.json
**/LETZTE_UMGEBUNG_*.json
*.prt
*.prt.*
*.bak
*.tmp
*.lck
*.log

# Python/editor/tool-local files
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv*/
venv/
.coverage
htmlcov/
.DS_Store
Thumbs.db
.vscode/
.idea/

# Credentials and personal configuration
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
*.p12
*.local.json
.codex/

# Release archives are deliverables, not repository source.
*.zip
*.7z
*.tar
*.tar.gz
*.tgz

# Native NX deliveries: only reviewed parts and compact build evidence.
/cad/nx/**
!/cad/nx/**/
!/cad/nx/**/*.prt
!/cad/nx/README.md
!/cad/nx/CURRENT.json
!/cad/nx/LAST_ATTEMPT.json
!/cad/nx/*/BUILD.json
!/cad/nx/*/VERIFY.json

# K02 independent states and their compact, separately scoped evidence.
!/cad/nx/k02/CURRENT.json
!/cad/nx/k02/LAST_ATTEMPT.json
!/cad/nx/k02/*/BUILD.json
!/cad/nx/k02/*/VERIFY.json

# M01 integrated master delivery and its independent native evidence.
!/cad/nx/m01/CURRENT.json
!/cad/nx/m01/LAST_ATTEMPT.json
!/cad/nx/m01/*/BUILD.json
!/cad/nx/m01/*/VERIFY.json
!/cad/nx/m01/README.md
