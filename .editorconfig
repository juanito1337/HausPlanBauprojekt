root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{md,yml,yaml,json}]
indent_size = 2

[projects/g02/**]
charset = unset
end_of_line = unset
insert_final_newline = false
trim_trailing_whitespace = false

[renovierung/k01_unterlagen/**]
charset = unset
end_of_line = unset
insert_final_newline = false
trim_trailing_whitespace = false
